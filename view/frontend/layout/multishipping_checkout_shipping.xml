<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="checkout_shipping">
            <!-- Rendered once per address by Plugin\Multishipping\AddDateFieldToAddress -->
            <block class="Magento\Framework\View\Element\Template" name="ecommet.delivery.date.multishipping" template="Ecommet_SmartDeliveryDate::multishipping/address-date.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Ecommet\SmartDeliveryDate\ViewModel\Multishipping</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
