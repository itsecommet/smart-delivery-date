{
    "name": "ecommet/module-smart-delivery-date",
    "description": "Estimated delivery dates on product, cart and checkout pages, plus a customer-selected delivery date at checkout that respects working days, cut-off time and excluded dates. Luma and Hyvä compatible.",
    "type": "magento2-module",
    "version": "2.0.0",
    "license": [
        "proprietary"
    ],
    "authors": [
        {
            "name": "Ecommet Solutions",
            "email": "ecommet.solutions@gmail.com",
            "homepage": "https://ecommet.in",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": "^103.0.6",
        "magento/module-backend": "^102.0",
        "magento/module-catalog": "^104.0",
        "magento/module-checkout": "^100.4",
        "magento/module-config": "^101.2",
        "magento/module-directory": "^100.4",
        "magento/module-eav": "^102.1",
        "magento/module-multishipping": "^100.4",
        "magento/module-quote": "^101.2",
        "magento/module-sales": "^103.0",
        "magento/module-store": "^101.1",
        "magento/module-ui": "^101.2"
    },
    "suggest": {
        "hyva-themes/magento2-default-theme": "Hyvä templates are included in this module"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Ecommet\\SmartDeliveryDate\\": ""
        }
    }
}
