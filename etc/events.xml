<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_model_service_quote_submit_before">
        <observer name="ecommet_smartdeliverydate_validate" instance="Ecommet\SmartDeliveryDate\Observer\ValidateQuoteDeliveryDate"/>
    </event>
    <event name="checkout_type_multishipping_create_orders_single">
        <observer name="ecommet_smartdeliverydate_copy_to_order" instance="Ecommet\SmartDeliveryDate\Observer\Multishipping\CopyDeliveryDateToOrder"/>
    </event>
    <event name="email_order_set_template_vars_before">
        <observer name="ecommet_smartdeliverydate_email_vars" instance="Ecommet\SmartDeliveryDate\Observer\AddEmailVariables"/>
    </event>
    <event name="hyva_config_generate_before">
        <observer name="ecommet_smartdeliverydate_hyva" instance="Ecommet\SmartDeliveryDate\Observer\RegisterHyvaModule"/>
    </event>
</config>
